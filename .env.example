# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modelos de reserva si el principal está saturado (503)
GEMINI_FALLBACKS=gemini-flash-lite-latest,gemini-3.8-flash
# Orígenes permitidos (separados por coma). * = todos (solo desarrollo)
CORS_ORIGINS=*

# Hardware: shared key the ESP32 sends in X-Device-Key (generate: python -c "import secrets;print(secrets.token_urlsafe(24))")
DEVICE_API_KEY=
# Storage for sensor readings (Upstash Redis, free). Created from Vercel > Storage; leave empty locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
