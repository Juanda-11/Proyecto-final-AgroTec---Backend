# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Modelos de reserva si el principal está saturado (503)
GEMINI_FALLBACKS=gemini-flash-lite-latest,gemini-3.8-flash
# Orígenes permitidos (separados por coma). * = todos (solo desarrollo)
CORS_ORIGINS=*
